Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"samples", "=", 
    SuperscriptBox["10", "6"]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["Y", "i"], ",", 
        SubscriptBox["H", "i"]}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "nc"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "1"}], ",", 
     RowBox[{"j", "\[LessEqual]", "nc"}], ",", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "123", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"T", ",", "i"}]], "=", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"RiceDistribution", "[", 
            RowBox[{
             SubscriptBox["\[Mu]", 
              RowBox[{"T", ",", "j", ",", "\[Kappa]"}]], ",", 
             FractionBox[
              RowBox[{
               SubscriptBox[
                OverscriptBox["r", "^"], 
                RowBox[{"T", ",", "j"}]], " ", 
               SqrtBox[
                RowBox[{
                 SubscriptBox["\[Kappa]", 
                  RowBox[{"T", ",", "j"}]], " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   SubscriptBox["\[Kappa]", 
                    RowBox[{"T", ",", "j"}]]}], ")"}]}]]}], 
              RowBox[{"1", "+", 
               SubscriptBox["\[Kappa]", 
                RowBox[{"T", ",", "j"}]]}]], ",", 
             FractionBox[
              SubscriptBox[
               OverscriptBox["r", "^"], 
               RowBox[{"T", ",", "j"}]], 
              SqrtBox[
               RowBox[{"2", "+", 
                RowBox[{"2", " ", 
                 SubscriptBox["\[Kappa]", 
                  RowBox[{"T", ",", "j"}]]}]}]]]}], "]"}], ",", "samples"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          SubscriptBox["L", "1"]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"i", ",", "R"}]], "=", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"GammaDistribution", "[", 
            RowBox[{
             SubscriptBox["\[Mu]", 
              RowBox[{"j", ",", "R", ",", "\[Alpha]"}]], ",", 
             FractionBox[
              SubscriptBox[
               OverscriptBox["r", "^"], 
               RowBox[{"j", ",", "R"}]], 
              SuperscriptBox[
               SubscriptBox["\[Mu]", 
                RowBox[{"j", ",", "R", ",", "\[Alpha]"}]], 
               RowBox[{"1", "/", 
                SubscriptBox["\[Alpha]", 
                 RowBox[{"j", ",", "R"}]]}]]], ",", 
             SubscriptBox["\[Alpha]", 
              RowBox[{"j", ",", "R"}]], ",", "0"}], "]"}], ",", "samples"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          SubscriptBox["L", "1"]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       SubscriptBox["h", 
        RowBox[{"T", ",", "R"}]], "=", 
       RowBox[{"EtaMu", "[", 
        RowBox[{
         SubscriptBox["\[Eta]", 
          RowBox[{"T", ",", "R"}]], ",", 
         SubscriptBox["\[Mu]", 
          RowBox[{"T", ",", "R", ",", "\[Eta]"}]], ",", 
         SubscriptBox["p", 
          RowBox[{"T", ",", "R"}]], ",", 
         SubscriptBox[
          OverscriptBox["r", "^"], 
          RowBox[{"T", ",", "R"}]], ",", "samples"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["Y", "j"], ",", 
         SubscriptBox["H", "j"]}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "1"}], 
           SubscriptBox["L", "1"]], 
          RowBox[{
           SubscriptBox["h", 
            RowBox[{"T", ",", "i"}]], " ", 
           SubscriptBox["h", 
            RowBox[{"i", ",", "R"}]]}]}], ",", 
         RowBox[{
          SubscriptBox["h", 
           RowBox[{"T", ",", "R"}]], "+", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"i", "=", "1"}], 
            SubscriptBox["L", "1"]], 
           RowBox[{
            SubscriptBox["h", 
             RowBox[{"T", ",", "i"}]], " ", 
            SubscriptBox["h", 
             RowBox[{"i", ",", "R"}]]}]}]}]}], "}"}]}], ";"}]}], 
